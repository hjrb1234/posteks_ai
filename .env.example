# Скопируйте в .env. Секреты вводятся только на сервере, не во frontend.
APP_MODE=SAFE
SAFE_MODE=true
MAIL_SEND_ENABLED=false
STORAGE_DIR=./storage
# SERVICE_STORAGE_ROOT — прежний alias, если STORAGE_DIR отсутствует.
# Относительные пути разрешаются от папки проекта.
# DATABASE_URL по умолчанию: новая SQLite storage/posteks_ai.db.
# Никогда не подключайте оригинальную posteks.db до аудита схемы и резервирования.
# DATABASE_URL=postgresql+psycopg://user:password@localhost/posteks_ai
COOKIE_SECURE=false
# Production: HTTPS, COOKIE_SECURE=true, APP_MODE=PRODUCTION.
ALLOWED_ORIGINS=
PUBLIC_BASE_URL=

# Без ключа работает локальный поиск, без генерации ответа AI.
OPENAI_API_KEY=
# Альтернативное имя для прокси-секрета облачной среды:
POSTEKS_OPENAI_API_KEY=
# Доступность модели проверяется отдельной командой в Настройках.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MAX_AI_DAILY_TOKENS=100000
MAX_AI_OUTPUT_TOKENS=4096
# Поиск официальных руководств, если в локальных материалах нет точного совпадения.
# Запрос к поиску содержит модель, код ошибки и тип технического вопроса.
POSTEKS_WEB_SEARCH_ENABLED=true
POSTEKS_WEB_SEARCH_DOMAINS=veichi.com,posteks.ru

# Реальное IMAP-чтение. SMTP-отправка заблокирована независимо от настроек.
MAIL_ADDRESS=
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_OAUTH_TOKEN=
MAIL_IMAP_HOST=imap.yandex.com
MAIL_IMAP_PORT=993
MAIL_MAILBOX=INBOX
# Пусто — автоматическое обнаружение папки с флагом Sent.
MAIL_SENT_FOLDER=
MAIL_POLL_ENABLED=false
MAIL_POLL_SECONDS=60
MAIL_INITIAL_DAYS=7
BUSINESS_TIMEZONE=Asia/Yekaterinburg

# Разделение входящих: домены компании и адреса отделов (не авторизация отправителя).
# Укажите действительный домен своей компании. Несколько доменов: через запятую.
CORPORATE_EMAIL_DOMAINS=posteks.ru
# Прежнее одиночное имя CORPORATE_EMAIL_DOMAIN поддерживается, если список не задан.
# Адрес собственного ящика определяется из MAIL_USERNAME/MAIL_ADDRESS выше.
DEPARTMENT_KB_EMAIL=
KB_RESPONSE_SENDERS=
DEPARTMENT_MANAGER_EMAIL=
DEPARTMENT_SALES_EMAIL=
DEPARTMENT_ASU_EMAIL=
DEPARTMENT_PRODUCTION_EMAIL=

# Установите бинарный Tesseract и запустите python -m scripts.install_ocr.
TESSDATA_PREFIX=./storage/tessdata
TESSERACT_CMD=
# Необязательный LibreOffice для преобразования DOC/XLS без макросов.
LIBREOFFICE_PATH=
# Для видео нужны FFmpeg и ffprobe, для WEBM/OGG-аудио нужен ffprobe.
# Если bin отсутствует в PATH, укажите пути к программам. Пример для Windows:
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
# Для распознавания аудио без ffprobe доступен WAV PCM длительностью до 2 минут.
FFPROBE_PATH=
FFMPEG_PATH=
# Импорт готовой TXT/JSON/CSV-переписки MAX не требует бота или токена.
# Ниже — необязательный экспорт только той истории, которую API разрешает боту.
# Полный архив обычной группы за годы не гарантируется.
# Отдельный токен MAX, не Telegram BOT_TOKEN. Никогда не публикуйте .env.
MAX_BOT_TOKEN=
