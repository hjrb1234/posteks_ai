{
  "name": "POSTEKS AI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {"ghcr.io/devcontainers/features/node:1": {"version": "22"}},
  "forwardPorts": [8080],
  "portsAttributes": {"8080": {"label": "POSTEKS AI", "onAutoForward": "notify"}},
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y tesseract-ocr && bash scripts/install.sh",
  "postStartCommand": "bash scripts/codespaces_start.sh",
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
